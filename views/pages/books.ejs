<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 my-4">
  <div>
    <h1 class="mb-1">Книжки</h1>
    <p class="text-body-secondary mb-0">Всього у каталозі: <%= books.length %></p>
  </div>
  <a href="/books/add-book" class="btn btn-primary">+ Додати книжку</a>
</div>

<% if (books.length === 0) { %>
<div class="text-center text-body-secondary py-5 border rounded-3 bg-body-tertiary">
  <p class="fs-4 mb-3">Книжок поки немає</p>
  <a href="/books/add-book" class="btn btn-outline-primary">Додати першу книжку</a>
</div>
<% } else { %>
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4 mb-5">
  <% books.forEach(book => { %>
  <div class="col">
    <div class="card book-card h-100 border-0 shadow-sm <%= book.is_active ? '' : 'book-card-inactive' %>">
      <div class="book-cover">
        <% if (book.image) { %>
        <img src="/images/<%= book.image %>" alt="<%= book.title %>">
        <% } else { %>
        <div class="book-cover-placeholder book-cover-placeholder-<%= book.id % 4 %>">
          <%= book.title.charAt(0).toUpperCase() %>
        </div>
        <% } %>
        <span class="badge book-status <%= book.is_active ? 'text-bg-success' : 'text-bg-dark' %>">
          <%= book.is_active ? "В наявності" : "Немає в наявності" %>
        </span>
      </div>
      <div class="card-body d-flex flex-column">
        <h5 class="card-title mb-1"><%= book.title %></h5>
        <% if (book.publication_year) { %>
        <p class="text-body-secondary small mb-0"><%= book.publication_year %> р.</p>
        <% } %>
        <div class="d-flex justify-content-between align-items-center mt-auto pt-3">
          <span class="book-price"><%= book.price %> грн</span>
          <% if (book.is_active) { %>
          <a href="#" class="btn btn-primary btn-sm px-3">Купити</a>
          <% } else { %>
          <button type="button" class="btn btn-outline-secondary btn-sm px-3" disabled>Купити</button>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <% }) %>
</div>
<% } %>
